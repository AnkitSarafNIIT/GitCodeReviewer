# Server
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=git_code_reviewer

# GitHub webhook secret — must match the secret entered in GitHub Settings > Webhooks
GITHUB_WEBHOOK_SECRET=replace_with_a_strong_random_secret

# Optional: comma-separated branch names to watch (e.g. main,develop).
# Leave empty or omit to accept pushes from all branches.
REVIEW_BRANCHES=main,develop
